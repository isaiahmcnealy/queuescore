# Copy to .env and fill in. .env is gitignored — never commit real keys.
# DRY_RUN=false → live Anthropic calls (requires ANTHROPIC_API_KEY; the default)
# DRY_RUN=true  → canned Claude text, zero API calls (fully offline work)
DRY_RUN=false
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (defaults shown; see src/config.py)
# ANTHROPIC_MODEL=claude-opus-4-8
# MATCH_MODEL=claude-haiku-4-5
