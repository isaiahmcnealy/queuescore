# Data files (raw LBNL xlsx + queue snapshots are not versioned)
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.csv
data/snapshots/*.parquet
data/snapshots/*.meta.json
data/snapshots/*.csv
data/snapshots/*.json
# Cross-source match table is small and needed for the live demo.
!data/snapshots/matches.parquet

# Secrets
.env

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Keep the directory placeholders
!data/raw/.gitkeep
!data/snapshots/.gitkeep

# app control
.app.pid
